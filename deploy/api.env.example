# Copied to /etc/settle/api.env on the VM (chmod 600) - fill in the values
# from Render's Environment page. Never commit the filled-in file.
# KEY=value, one per line, no quotes needed.

DATABASE_URL=
# Copy Render's value exactly - a new one signs everybody out
SECRET_KEY=
CRON_SECRET=

ALLOWED_ORIGINS=https://www.settle0.in.net,https://settle0.in.net
FRONTEND_URL=https://www.settle0.in.net
# The API now lives under /api on the same address (Google's Gmail redirect too)
API_BASE_URL=https://www.settle0.in.net/api

SMTP_SENDER=
SMTP_APP_PASSWORD=
BREVO_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GROQ_API_KEY=
GROQ_API_KEY_2=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OCRSPACE_API_KEY=
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=
GOOGLE_VISION_API_KEY=

# Copy Render's - new keys would cut off everyone's notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=
