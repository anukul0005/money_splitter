DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
# Get this from Supabase: Project Settings → Database → Connection string → URI
# Replace [PASSWORD] with your Supabase DB password
# Replace [HOST] with your Supabase host (e.g. db.xxxxxxxxxxxx.supabase.co)

ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Used to build the link included in activity notification emails
FRONTEND_URL=http://localhost:5173

# Email. SMTP_SENDER is the From address for every transport below, so it is
# required for any mail at all to go out; the app starts fine without it and
# simply sends nothing. SMTP_APP_PASSWORD is a 16-char App Password generated
# at https://myaccount.google.com/apppasswords (NOT your normal Gmail
# password — that won't work with 2FA enabled). Paste it without the spaces
# Google displays, though they are stripped for you either way.
SMTP_SENDER=
SMTP_APP_PASSWORD=

# Brevo's HTTP API, tried before SMTP. Needed in any deployment whose host
# blocks outbound SMTP — Render drops 465 and 587 alike, so mail has to leave
# over HTTPS there. Leave blank locally, where Gmail SMTP works fine and the
# fallback handles it. SMTP_SENDER must be verified as a sender in Brevo
# (Senders, Domains & Dedicated IPs → Senders) or every send is rejected.
BREVO_API_KEY=
