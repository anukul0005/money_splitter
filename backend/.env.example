DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
# Get this from Supabase: Project Settings → Database → Connection string → URI
# Replace [PASSWORD] with your Supabase DB password
# Replace [HOST] with your Supabase host (e.g. db.xxxxxxxxxxxx.supabase.co)

ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Used to build the link included in activity notification emails
FRONTEND_URL=http://localhost:5173

# Optional: enables email notifications for 2-member "master group" activity.
# Leave blank to disable — notifications are skipped silently if unset.
# SMTP_SENDER must be a Gmail address; SMTP_APP_PASSWORD is a 16-char App
# Password generated at https://myaccount.google.com/apppasswords (NOT your
# normal Gmail password — that won't work with 2FA enabled).
SMTP_SENDER=
SMTP_APP_PASSWORD=
